# Basis REST API.
# Kosongkan atau biarkan "/api" selama masih memakai data lokal Nitro.
# Isi dengan URL Laravel setelah dashboard siap — tidak ada kode yang perlu diubah.
NUXT_PUBLIC_API_BASE=/api

# Domain publik. Dipakai untuk canonical URL, sitemap, dan Open Graph.
# Selama masih localhost, robots.txt otomatis memblokir pengindeksan.
NUXT_PUBLIC_SITE_URL=https://tanimakmur.co.id
NUXT_SITE_URL=https://tanimakmur.co.id
